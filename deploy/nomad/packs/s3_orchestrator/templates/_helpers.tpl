[[- define "job_name" -]]
[[ var "job_name" . | quote ]]
[[- end -]]

[[- define "service_name" -]]
[[ coalesce (var "service_name" .) (var "job_name" .) ]]
[[- end -]]

[[- define "hcl_escape" -]]
[[ . | replace "${" "$${" | replace "%{" "%%{" ]]
[[- end -]]

[[- /* mTLS leaves an HTTP check no client certificate, so it falls back to TCP. An HTTPS check dials the instance's address, which the certificate need not name. */ -]]
[[- define "check_transport" -]]
[[- if eq .tls "mtls" ]]
type = "tcp"
[[- else ]]
type = "http"
path = [[ .path | quote ]]
[[- if eq .tls "tls" ]]
protocol        = "https"
tls_skip_verify = true
[[- end ]]
[[- end ]]
[[- end -]]

[[- define "config" -]]
[[ template "hcl_escape" (fileContents (var "config_file" .)) ]]
[[- end -]]

[[- define "preflight" -]]
[[- if not (var "version" .) -]]
[[- fail "version is required, set to the image tag to run, such as v0.191.0" -]]
[[- end -]]
[[- if not (var "config_file" .) -]]
[[- fail "config_file is required, set to the path of the config.yaml to run" -]]
[[- end -]]
[[- $config := fileContents (var "config_file" .) -]]
[[- if not (has (var "mode" .) (list "all" "api" "worker")) -]]
[[- fail "mode must be one of all, api or worker" -]]
[[- end -]]
[[- if not (has (var "service_provider" .) (list "nomad" "consul")) -]]
[[- fail "service_provider must be nomad or consul" -]]
[[- end -]]
[[- if not (has (var "tls_mode" .) (list "off" "tls" "mtls")) -]]
[[- fail "tls_mode must be one of off, tls or mtls" -]]
[[- end -]]
[[- if or (regexMatch `(?m)^\s+driver:\s*["']?sqlite` $config) (not (regexMatch `(?m)^\s+host:` $config)) -]]
[[- fail "SQLite cannot run on this pack, since the root filesystem is read-only and an allocation keeps nothing across a reschedule; set database.host to a PostgreSQL server" -]]
[[- end -]]
[[- if and (gt (int (var "count" .)) 1) (not (regexMatch "(?m)^redis:" $config)) -]]
[[- fail "count above 1 requires redis in the config, or each instance enforces usage limits against its own counters" -]]
[[- end -]]
[[- end -]]
