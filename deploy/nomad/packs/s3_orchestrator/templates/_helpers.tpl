[[- define "job_name" -]]
[[ var "job_name" . | quote ]]
[[- end -]]

[[- define "service_name" -]]
[[ coalesce (var "service_name" .) (var "job_name" .) ]]
[[- end -]]

[[- define "config" -]]
[[ fileContents (var "config_file" .) | replace "${" "$${" | replace "%{" "%%{" ]]
[[- end -]]

[[- define "preflight" -]]
[[- if not (var "version" .) -]]
[[- fail "version is required, set to the image tag to run, such as v0.178.0" -]]
[[- end -]]
[[- if not (var "config_file" .) -]]
[[- fail "config_file is required, set to the path of the config.yaml to run" -]]
[[- end -]]
[[- if not (has (var "mode" .) (list "all" "api" "worker")) -]]
[[- fail "mode must be one of all, api or worker" -]]
[[- end -]]
[[- if not (has (var "service_provider" .) (list "nomad" "consul")) -]]
[[- fail "service_provider must be nomad or consul" -]]
[[- end -]]
[[- if and (gt (int (var "count" .)) 1) (not (regexMatch "(?m)^redis:" (fileContents (var "config_file" .)))) -]]
[[- fail "count above 1 requires redis in the config, or each instance enforces usage limits against its own counters" -]]
[[- end -]]
[[- end -]]
